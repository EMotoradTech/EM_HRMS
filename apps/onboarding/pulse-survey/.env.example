DATABASE_URL="postgresql://em_hrms:em_hrms_local@localhost:5432/em_hrms_pulse_survey?schema=public"
PORT=4003
CONTENT_DIR=./content

# Secret used to derive the one-way dedupe-token hash from (employee identifier + period).
# This is NEVER stored, and the hash cannot be reversed back to the identifier — it only
# lets us reject a second submission from the same person in the same period.
# Rotate this only if you're comfortable resetting duplicate-detection for one period.
DEDUPE_TOKEN_SECRET=change-me-in-real-deployment
