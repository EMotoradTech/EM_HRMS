# Postgres connection for this app's own database (one DB per leaf app).
DATABASE_URL="postgresql://em_hrms:em_hrms_local@localhost:5432/em_hrms_offer_letters?schema=public"

# Port the Express server listens on.
PORT=4003

# "mock" (default) uses the in-process mock in
# src/services/documentEngineClient.ts, for local dev/test without a running
# document-engine. Switch to "http" to call the real
# apps/foundations/document-engine — DOCUMENT_ENGINE_TOKEN must match that
# app's own INTERNAL_API_KEY (see its .env.example).
DOCUMENT_ENGINE_MODE=mock
DOCUMENT_ENGINE_BASE_URL=http://localhost:4001
DOCUMENT_ENGINE_TOKEN=dev-local-shared-secret
# How often (ms) to poll the real engine for status changes in "http" mode
# (it has no webhook). Optional, defaults to 3000.
DOCUMENT_ENGINE_POLL_INTERVAL_MS=3000
