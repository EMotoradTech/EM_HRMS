# Postgres connection for this app's own database (one DB per leaf app).
DATABASE_URL="postgresql://em_hrms:em_hrms_local@localhost:5432/em_hrms_offer_letters?schema=public"

# Port the Express server listens on.
PORT=4003

# "mock" (default) uses the in-process mock in
# src/services/documentEngineClient.ts, matching docs/contracts/document-engine-api.md.
# Switch to "http" once Person A's real document-engine is available and set
# DOCUMENT_ENGINE_BASE_URL / DOCUMENT_ENGINE_TOKEN.
DOCUMENT_ENGINE_MODE=mock
DOCUMENT_ENGINE_BASE_URL=
DOCUMENT_ENGINE_TOKEN=
