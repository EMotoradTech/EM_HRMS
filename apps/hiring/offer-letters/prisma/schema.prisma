generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OfferStatus {
  SELECTED
  OFFER_GENERATED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
  SIGNED
  ONBOARDING_READY
}

model OfferCandidate {
  id                String      @id @default(cuid())
  name              String
  email             String
  role              String
  ctc               String?
  joiningDate       DateTime?
  documentEngineId  String?
  status            OfferStatus @default(SELECTED)
  statusHistory     Json        @default("[]")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}
