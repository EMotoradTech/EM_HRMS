    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.19.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
