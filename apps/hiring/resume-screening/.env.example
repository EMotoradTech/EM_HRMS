# Postgres connection for this app's own database (one DB per leaf app).
DATABASE_URL="postgresql://em_hrms:em_hrms_local@localhost:5432/em_hrms_resume_screening?schema=public"

# Port the Express server listens on.
PORT=4001

# Set to "true" once Naukri's recruiter account is confirmed to expose an
# API/export path (see docs/briefs/person-b-hiring.md, "validate before
# deep-building"). Until then the app only supports bulk resume upload.
NAUKRI_API_ENABLED=false
NAUKRI_API_BASE_URL=
NAUKRI_API_KEY=
